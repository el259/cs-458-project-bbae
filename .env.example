# Copy to .env and fill in your personal DEVELOPMENT credentials.
# Never use HUMGLOT_APP or Oracle ADMIN credentials here.
DB_USERNAME=HUMGLOT_DEV_YOURNAME
DB_PASSWORD=REPLACE_WITH_YOUR_UNIQUE_PASSWORD
# Must match an alias in .local/oracle-wallet/tnsnames.ora
DB_CONNECT_STRING=humglot_tp

# Humboldt CAS. Use cas-dev.humboldt.edu for testing, then switch all
# CAS URLs together to cas.humboldt.edu for production.
CAS_LOGIN_URL=https://cas-dev.humboldt.edu/cas/login
CAS_LOGOUT_URL=https://cas-dev.humboldt.edu/cas/logout
CAS_VALIDATE_URL=https://cas-dev.humboldt.edu/cas/validate
CAS_SERVICE_URL=https://humglot.blakeculbertson.com/cas/callback.php
# Keep local username/password accounts available while CAS is being tested.
LOCAL_AUTH_ENABLED=true
